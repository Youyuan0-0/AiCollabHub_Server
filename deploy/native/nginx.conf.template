worker_processes auto;
pid @@DATA@@/web/nginx.pid;
error_log stderr warn;
events { worker_connections 2048; }
http {
    include @@RUNTIME@@/nginx/conf/mime.types;
    default_type application/octet-stream;
    map $arg_ticket $diagnostic_ticket_present { "" 0; default 1; }
    map $arg_state $diagnostic_state_present { "" 0; default 1; }
    # 只接收首页 GET 请求中的票据；空票据也交给后端显示参数错误。
    map "$request_method:$args" $home_ticket_present {
        default 0;
        "~^GET:(?:[^&]*&)*ticket(?:=|&|$)" 1;
    }
    # 不记录查询串、票据或 Cookie。
    log_format application '$time_iso8601 $request_id $request_method $uri $status $request_time '
                           'upstream_status=$upstream_status upstream_time=$upstream_response_time '
                           'api_request_id=$upstream_http_x_request_id '
                           'ticket_present=$diagnostic_ticket_present state_present=$diagnostic_state_present '
                           'local_port=$server_port';
    access_log @@DATA@@/web/access.log application;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30;
    client_body_temp_path @@DATA@@/web/body;
    proxy_temp_path @@DATA@@/web/body;
    fastcgi_temp_path @@DATA@@/web/fastcgi;
    uwsgi_temp_path @@DATA@@/web/uwsgi;
    scgi_temp_path @@DATA@@/web/scgi;
    upstream platform_api {
        server 127.0.0.1:@@API_PORT@@;
        keepalive 16;
    }
    server {
        listen 0.0.0.0:@@WEB_PORT@@@@TLS_LISTEN@@;
        @@WEB_EXTRA_LISTEN@@
        server_name _;
        absolute_redirect off;
        @@TLS_CONFIG@@
        root @@RELEASE@@/frontend/user;
        client_max_body_size 11m;
        location = / {
            if ($home_ticket_present) {
                add_header Cache-Control "no-store" always;
                add_header Referrer-Policy "no-referrer" always;
                return 303 /api/v1/auth/home-callback$is_args$args;
            }
            try_files /index.html =404;
        }
        location = /diagnostics/auth.html {
            alias @@RELEASE@@/diagnostics/browser.html;
            add_header Cache-Control "no-store" always;
            add_header Referrer-Policy "no-referrer" always;
        }
        location = /admin/diagnostics/auth.html {
            alias @@RELEASE@@/diagnostics/browser.html;
            add_header Cache-Control "no-store" always;
            add_header Referrer-Policy "no-referrer" always;
        }
        location ~ ^/api/v1/admin/(application|tool)-publications/[^/]+/report-files$ {
            client_max_body_size 21m;
            include @@CONFIG@@/proxy.conf;
        }
        location ~ ^/api/v1/knowledge-bases/[^/]+/files$ {
            client_max_body_size 201m;
            include @@CONFIG@@/proxy.conf;
        }
        location = /api/v1/application-tutorial-files {
            client_max_body_size 101m;
            include @@CONFIG@@/proxy.conf;
        }
        location = /api/v1/feedback/attachments {
            client_max_body_size 1025m;
            include @@CONFIG@@/proxy.conf;
        }
        location /api/ { include @@CONFIG@@/proxy.conf; }
        location /api/v1/auth/iam/ { return 404; }
        @@MOCK_IAM_PROXY@@
        location = /admin {
            if ($home_ticket_present) {
                add_header Cache-Control "no-store" always;
                add_header Referrer-Policy "no-referrer" always;
                return 303 /api/v1/auth/home-callback$is_args$args;
            }
            return 302 /admin/;
        }
        location = /admin/ {
            if ($home_ticket_present) {
                add_header Cache-Control "no-store" always;
                add_header Referrer-Policy "no-referrer" always;
                return 303 /api/v1/auth/home-callback$is_args$args;
            }
            rewrite ^ /admin/index.html last;
        }
        location /admin/ {
            alias @@RELEASE@@/frontend/admin/;
            try_files $uri $uri/ /admin/index.html;
        }
        location / { try_files $uri $uri/ /index.html; }
    }
    @@IAM_INGRESS_SERVERS@@
}
