# PostgreSQL 主库同步复制参数示例，不用于单库开发。
# 先完成备库初始化、复制连接和只读验证，再启用同步等待。
wal_level = replica
max_wal_senders = 4
max_replication_slots = 4

# 备库的 primary_conninfo 必须包含 application_name=aicollabhub_standby。
# 两项必须同时生效；没有指定同步备库时，仅 remote_apply 不保证等待备库。
synchronous_standby_names = 'FIRST 1 (aicollabhub_standby)'
synchronous_commit = remote_apply

# 禁止自动降级为异步提交。备库不可用时提交会等待，需配合入口限流和运维处理。
# 此文件仅描述复制和提交策略；网络、复制账号、访问规则及备份另行配置。
