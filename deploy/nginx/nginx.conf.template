worker_processes @@NGINX_WORKERS@@;
pid logs/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 8192; }
http {
    include mime.types;
    default_type application/octet-stream;
    log_format application '$request_id $request_method $uri $status $upstream_addr $request_time';
    access_log logs/access.log application;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30;
    upstream platform_api {
        server 127.0.0.1:@@API_PORT@@;
        keepalive 16;
    }
    server {
        listen @@LISTEN_HOST@@:@@GATEWAY_PORT@@;
        server_name localhost;
        root "@@USER_DIST@@";
        client_max_body_size 11m;
        # 审核报告单个最大 20 MiB，包含 multipart 开销；仅放宽附件入口。
        location ~ ^/api/v1/admin/application-publications/[^/]+/report-files$ {
            client_max_body_size 21m;
            client_body_timeout 120s;
            proxy_pass http://platform_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 180s;
            proxy_send_timeout 120s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_next_upstream off;
        }
        # 教程每次上传一个文件，允许 100 MiB 视频及 multipart 开销。
        location = /api/v1/application-tutorial-files {
            client_max_body_size 101m;
            client_body_timeout 120s;
            proxy_pass http://platform_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 180s;
            proxy_send_timeout 120s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_next_upstream off;
        }
        # 反馈每次只上传一个文件，允许 1 GiB 正文及 multipart 开销。
        location = /api/v1/feedback/attachments {
            client_max_body_size 1025m;
            client_body_timeout 120s;
            proxy_pass http://platform_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 120s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_next_upstream off;
        }
        location /api/ { include platform-proxy.conf; }
        location = /admin { return 302 /admin/; }
        location /admin/ {
            alias "@@ADMIN_DIST@@/";
            try_files $uri $uri/ /admin/index.html;
        }
        location / { try_files $uri $uri/ /index.html; }
    }
}
