    # 浏览器只通过 8086 接收 CAS 回调，IAM 也只通过此端口通知单点登出。
    server {
        listen @@LISTEN_HOST@@:@@IAM_CALLBACK_PORT@@;
        server_name localhost;
        location = /api/v1/auth/callback {
            limit_except GET { deny all; }
            include platform-proxy.conf;
        }
        location = /api/v1/auth/single-logout {
            limit_except POST { deny all; }
            client_max_body_size 16k;
            include platform-proxy.conf;
        }
        location / { return 404; }
    }

    # 身份推送独立暴露在 8085，只转发已鉴权的 IAM 推送入口。
    server {
        listen @@LISTEN_HOST@@:@@IAM_SYNC_PORT@@;
        server_name localhost;
        location = /api/v1/auth/iam/identity-sync {
            limit_except POST { deny all; }
            client_max_body_size 256k;
            include platform-proxy.conf;
        }
        location / { return 404; }
    }
