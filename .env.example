# 日常运行配置统一放项目根目录 .env；本文件只提供模板，不填写真实凭证。
# 后端、迁移命令和模拟 IAM 共用 .env，无需另建认证配置文件。
APP_NAME="AiCollabHub API"
# production 要求配置数据库，并关闭交互文档与 OpenAPI 描述。
APP_ENV=development
INSTANCE_ID=api
# 业务 API 仍为 Mock；认证由下面的 AUTH_MODE 独立控制。
# 真实同步备库验证后开启，应用在写事务中检查 remote_apply 与指定同步备库配置。
DB_REQUIRE_SYNC_APPLY=false
DB_STATEMENT_TIMEOUT_MS=15000
# 提交等待单独计时；超时不代表回滚，调用方需使用原幂等键核对。
DB_COMMIT_TIMEOUT_MS=10000

# PostgreSQL 主库：HOST 填域名或 IP；密码填原文，含空格或 # 时用引号包住。
# 后端使用 psycopg 3 自动组装连接串，不需要手工进行 URL 编码。
# 尚无服务时这组保持空值；启用时 HOST、DB、USER、PASSWORD 必须一起填写。
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 可选迁移连接，必须指向主库；整组留空时 Alembic 使用上方主库连接。
# 启用时独立填写 HOST、DB、USER、PASSWORD；迁移只在发布时执行一次。
POSTGRES_MIGRATION_HOST=
POSTGRES_MIGRATION_PORT=5432
POSTGRES_MIGRATION_DB=
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=

# 备库连接必须指向参与 remote_apply 确认的同步备库；使用独立只读账号。
# 各组连接不继承主库凭证，启用时 HOST、DB、USER、PASSWORD 必须一起填写。
# 写操作和先读后改仍走主库；仅显式使用只读依赖的业务查询参与分流。
POSTGRES_READ_HOST=
POSTGRES_READ_PORT=5432
POSTGRES_READ_DB=
POSTGRES_READ_USER=
POSTGRES_READ_PASSWORD=
DB_READ_ENABLED=false
# 0 表示纯查询全部走主库，100 表示全部走备库，中间值为备库分流百分比。
DB_READ_WEIGHT=100
# 仅备库获取连接失败时允许一次回退；独立连接池限制回退连接数。
# 该连接指向主库，建议使用只读账号。查询执行后的错误不会跨库重试。
POSTGRES_READ_FALLBACK_HOST=
POSTGRES_READ_FALLBACK_PORT=5432
POSTGRES_READ_FALLBACK_DB=
POSTGRES_READ_FALLBACK_USER=
POSTGRES_READ_FALLBACK_PASSWORD=
DB_READ_FALLBACK_ENABLED=false

# 兼容原有 DATABASE_URL、DATABASE_READ_URL、DATABASE_MIGRATION_URL、
# DATABASE_READ_FALLBACK_URL；显式填写 URL 时，该连接优先使用 URL。
# 使用分字段配置时不要同时设置对应 URL，避免旧地址覆盖新配置。

# 以下为每个进程、每个数据库连接池的预算，不是全平台连接数或容量承诺。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# 可选共享缓存；HOST 留空且未填写凭证时不启用。
# ACL 认证填写 USER 和 PASSWORD；仅密码认证时 USER 留空；无认证时两者留空。
# 两台后端使用相同的地址、前缀与 APP_ENV，缓存失败按未命中处理。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
# 兼容原有 REDIS_URL，显式填写时优先使用 URL；分字段时不要同时设置。
REDIS_KEY_PREFIX=aicollabhub
REDIS_DEFAULT_TTL=300
REDIS_TIMEOUT=1
REDIS_MAX_CONNECTIONS=20

# 文件服务启用时下面三项必须一起填写，否则全部留空。
# ENDPOINT 示例：http://HOST:9000，使用 S3 API 端口，不使用管理控制台端口。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 桶由服务部署方预先创建，应用不自动建桶；两台后端使用相同的桶。
MINIO_BUCKET=aicollabhub-files
MINIO_REGION=us-east-1
MINIO_TIMEOUT=5
# 默认限制为 50 MiB；业务模块还需按文件类型设置更具体的上传规则。
MINIO_MAX_UPLOAD_BYTES=52428800

# compose.dev.yaml 共用上方 POSTGRES_DB、USER、PASSWORD 和 PORT。
# 本机直连该 Compose 数据库时填写 POSTGRES_HOST=127.0.0.1。

# Vue 使用同源代理时保持 []；跨域时填写 JSON 数组，例如 ["http://localhost:5173"]。
CORS_ORIGINS=[]

# 单点登录联调：disabled 保留匿名框架模式，mock 启用模拟 IAM（禁止生产使用）。
# mock 模式先配置 POSTGRES_*，执行 alembic upgrade head，再启动独立模拟 IAM。
# python -m scripts.configure_mock_auth 在 .env 中补齐认证参数，保留已有密钥和服务配置。
# 本地双实例启动：
# .\scripts\start-local.ps1 -NginxRoot <Nginx目录> -ApiPortA 18000 -ApiPortB 18001 -GatewayPort 18880 -MockIamPort 18002
# 若修改下方 URL 端口，同步调整上述启动参数；启动时不再传入额外环境文件。
AUTH_MODE=disabled
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:18880
AUTH_MOCK_IAM_URL=http://127.0.0.1:18002
# 两台 API 与模拟 IAM 共用随机密钥，至少 32 字符；只放本地环境，不提交仓库。
AUTH_MOCK_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=28800
AUTH_LOGIN_TTL=300
AUTH_AUDIT_RETENTION_DAYS=90
# 仅为模拟环境准入，真实集团角色映射未实现。
AUTH_MOCK_ADMIN_SUBJECTS=["mock-admin"]
