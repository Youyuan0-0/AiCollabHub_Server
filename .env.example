APP_NAME="AiCollabHub API"
# production 要求配置数据库，并关闭交互文档与 OpenAPI 描述。
APP_ENV=development
INSTANCE_ID=api
# 当前只提供无需登录的 Mock API，不含真实业务；production 不注册 Mock 路由。
# 真实同步备库验证后开启，应用在写事务中检查 remote_apply 与指定同步备库配置。
DB_REQUIRE_SYNC_APPLY=false
DB_STATEMENT_TIMEOUT_MS=15000
# 提交等待单独计时；超时不代表回滚，调用方需使用原幂等键核对。
DB_COMMIT_TIMEOUT_MS=10000

# 当前使用 PostgreSQL + psycopg 3；用户名、密码、地址和库名按实际环境填写。
# 密码包含 @、:、/ 等特殊字符时，需要在 URL 中进行百分号编码。
# 尚无服务时保持空值，应用仍可启动，但涉及数据库的接口返回 503。
# DATABASE_URL=postgresql+psycopg://aicollabhub:change-me-for-local-dev@127.0.0.1:5432/aicollabhub
DATABASE_URL=

# 迁移账号可单独配置；为空时 Alembic 使用 DATABASE_URL。迁移只在发布时执行一次。
DATABASE_MIGRATION_URL=

# 验证主备同步后再开启；READ_URL 必须指向参与 remote_apply 确认的同步备库。
# 写操作和先读后改仍走主库；仅显式使用只读依赖的业务查询参与分流。
DATABASE_READ_URL=
DB_READ_ENABLED=false
# 0 表示纯查询全部走主库，100 表示全部走备库，中间值为备库分流百分比。
DB_READ_WEIGHT=100
# 仅备库获取连接失败时允许一次回退；独立连接池限制回退连接数。
# 此 URL 指向主库，建议使用只读账号。查询执行后的错误不会跨库重试。
DATABASE_READ_FALLBACK_URL=
DB_READ_FALLBACK_ENABLED=false

# 以下为每个进程、每个数据库连接池的预算，不是全平台连接数或容量承诺。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# 可选共享缓存；地址示例：redis://:URL_ENCODED_PASSWORD@HOST:6379/0。
# 两台后端使用相同的地址、前缀与 APP_ENV，缓存失败按未命中处理。
REDIS_URL=
REDIS_KEY_PREFIX=aicollabhub
REDIS_DEFAULT_TTL=300
REDIS_TIMEOUT=1
REDIS_MAX_CONNECTIONS=20

# 文件服务启用时下面三项必须一起填写，否则全部留空。
# ENDPOINT 示例：http://HOST:9000，使用 S3 API 端口，不使用管理控制台端口。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 桶由服务部署方预先创建，应用不自动建桶；两台后端使用相同的桶。
MINIO_BUCKET=aicollabhub-files
MINIO_REGION=us-east-1
MINIO_TIMEOUT=5
# 默认限制为 50 MiB；业务模块还需按文件类型设置更具体的上传规则。
MINIO_MAX_UPLOAD_BYTES=52428800

# 以下两项仅供 compose.dev.yaml 启动本地开发数据库使用。
# 使用本地 Compose 时，填写上方 DATABASE_URL 并与这里保持一致。
# 这里填写未编码的原始密码；不要在仓库模板中放真实账号密码。
POSTGRES_PASSWORD=change-me-for-local-dev
POSTGRES_PORT=5432

# Vue 使用同源代理时保持 []；跨域时填写 JSON 数组，例如 ["http://localhost:5173"]。
CORS_ORIGINS=[]
