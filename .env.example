# 后端、迁移、模拟 IAM 和单机服务编排共用根目录 .env；不提交真实凭据。
APP_NAME="AiCollabHub API"
APP_ENV=development
INSTANCE_ID=api
# 配置 PostgreSQL 后固定使用 resource_foundation 的 43 张表，不自动建表。
# 旧 *_STORAGE 变量只为历史配置兼容，不再选择数据库中的旧表或内存存储。
# local 完成平台发布；新资源仍默认禁用，须由管理端启用。external 等待供应方同步。
DATASETS_PUBLICATION_MODE=local
# 外部目录/发布与智能体运行分别配置。默认关闭，不会请求文档示例地址。
APPLICATIONS_MARKET=disabled
APPLICATIONS_MARKET_URL=
APPLICATIONS_MARKET_ADMIN_TOKEN=
APPLICATIONS_MARKET_CONFIGURATION=config/application-market.example.json
APPLICATIONS_MARKET_TIMEOUT=15
# 每个发布者独立凭证，键为配置 JSON 中 developer_token_env 引用的名字。
# 也可由进程环境变量提供；不要把真实值写入版本库。
APPLICATIONS_MARKET_DEVELOPER_TOKENS={}
# 认证由下面的 AUTH_MODE 独立控制；所有数据库事务共用单库连接。
DB_STATEMENT_TIMEOUT_MS=15000

# 唯一业务数据库，所有读写共用连接；HOST 留空可运行不依赖数据库的 Mock。
# 启用时 HOST、DB、USER、PASSWORD 必须一起填写，密码填写原文。
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 可选：同一数据库的独立迁移账号，整组留空时使用上方连接。
# 迁移只在发布时执行一次，不在 worker 启动时执行。
POSTGRES_MIGRATION_HOST=
POSTGRES_MIGRATION_PORT=5432
POSTGRES_MIGRATION_DB=
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=

# 也支持 DATABASE_URL、DATABASE_MIGRATION_URL；显式 URL 优先于对应分字段配置。
# 每个 worker 各自维护连接池，总上限约为 Workers * (SIZE + OVERFLOW)。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=5
# 此项只在借用连接时按连接年龄检查，不会主动释放闲置连接。
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
# PostgreSQL 14+：仅本项目连接连续空闲多少秒后释放；0 关闭，下次借用自动重连。
# 不改变事务空闲超时；定时任务和数据库健康检查也属于使用连接。
DB_IDLE_SESSION_TIMEOUT=120
# 程序名自动包含 APP_ENV、INSTANCE_ID、主机和 PID，无需配置 PGAPPNAME。

# 缓存可选，HOST 与凭据全部留空时不启用；所有 worker 共用前缀和 APP_ENV。
# ACL 认证填 USER、PASSWORD；仅密码认证时 USER 留空。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
# 显式 REDIS_URL 优先于分字段配置。
REDIS_KEY_PREFIX=aicollabhub
REDIS_DEFAULT_TTL=300
REDIS_TIMEOUT=1
REDIS_MAX_CONNECTIONS=20

# MinIO 应用连接。启用时 ENDPOINT、ACCESS_KEY、SECRET_KEY 一起填写。
# ENDPOINT 为 S3 接口地址，如 http://127.0.0.1:9000，不能填控制台端口。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aicollabhub-files
MINIO_REGION=us-east-1
MINIO_TIMEOUT=5
MINIO_MAX_UPLOAD_BYTES=1073741824
# 每个后端进程同时接收的反馈附件数；为临时落盘预留并发数乘以 1 GiB 的空间。
FEEDBACK_UPLOAD_CONCURRENCY=2

# compose.yaml 使用：首次部署时创建 MinIO 管理账号，再配置 Bucket 和应用凭据。
# 数据库和 Redis 共用上方 POSTGRES_*、REDIS_PASSWORD、REDIS_PORT。
MINIO_ROOT_USER=aicollabadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 同源 Nginx/Vite 代理保持 []；跨域时填写 JSON 来源数组。
CORS_ORIGINS=[]
# 平台附件统一存 MinIO，元信息及引用存 PostgreSQL。

# 认证：disabled 为匿名 Mock，mock 启用模拟 IAM，iam 使用集团 CAS；production 禁止 mock。
# python -m scripts.configure_mock_auth 在 .env 中初始化认证参数，保留服务配置。
# .\scripts\start-local.ps1 -NginxRoot <Nginx目录> -ApiPort 18000 -Workers 2 -GatewayPort 18880 -MockIamPort 18002
AUTH_MODE=disabled
# 本期仅单点登录：首登按 workNo 建号，本地命令维护管理员；不开启身份推送。
AUTH_IDENTITY_SYNC_ENABLED=false
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:18880
AUTH_MOCK_IAM_URL=http://127.0.0.1:18002
# 可选容器内网来源：仅用于后端票据验证、IAM 注销通知，不改变浏览器跳转。
AUTH_INTERNAL_ORIGIN=
AUTH_MOCK_IAM_INTERNAL_URL=
# API worker 与模拟 IAM 共用至少 32 字符的随机密钥，只保存在本地配置。
AUTH_MOCK_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=28800
AUTH_LOGIN_TTL=300
AUTH_MOCK_ADMIN_SUBJECTS=["mock-admin","mock-admin-b"]

# 集团 CAS 已确认的地址和应用编号，仅 AUTH_MODE=iam 时使用。
# 正式网站：http://fdj-smartweb.aecc.cn（HTTP 80，内网 IP 20.1.4.240）。
# 上线设置 AUTH_PUBLIC_ORIGIN=http://fdj-smartweb.aecc.cn，
# AUTH_CALLBACK_ORIGIN=http://fdj-smartweb.aecc.cn:8086；浏览器需能访问回调端口。
AUTH_IAM_ORIGIN=http://hfidaas-sso.aecc.cn
AUTH_IAM_APP_ID=796872537136820224
# 以下角色编码只在将来启用身份同步时使用。
AUTH_IAM_ADMIN_ROLE_CODE=platform_admin
AUTH_IAM_TIMEOUT=5
AUTH_CALLBACK_ORIGIN=
# 独立随机密钥，至少 32 字符；正式模式不读取 AUTH_MOCK_SECRET。
AUTH_SESSION_SECRET=
# IAM 推送无签名：填写推送服务器实际源 IP/CIDR 的 JSON 数组，空数组拒绝所有推送。
# 例 ["192.0.2.10/32"] 仅展示格式，不能把 IAM 域名解析结果直接当作推送来源。
AUTH_IAM_SYNC_ALLOWED_NETWORKS=[]

# 场景应用普通智能体运行：默认模拟；agent_dev 使用 Agent Dev 正式 HTTP 协议。
# 正式地址/APP_KEY 仅放本机环境；不把凭证放进前端或绑定 JSON。
APPLICATIONS_RUNTIME=simulation
APPLICATIONS_AGENT_URL=
APPLICATIONS_AGENT_KEY=
APPLICATIONS_AGENT_BINDINGS=
APPLICATIONS_AGENT_TIMEOUT=20
# 三模块工具链：disabled 关闭工具链调用；mock 使用文档协议模拟；live 调用供应方。
# 无真实服务时保持 disabled；隔离测试可显式使用 mock，不代表完成真实接口联调。
TOOLCHAIN_MODE=disabled
# AI 工具独立选择 disabled/mock/live；推荐在后台填写本模块独立连接和凭据。
TOOLCHAIN_TOOLS_MODE=disabled
TOOLCHAIN_MODELS_MODE=disabled
TOOLCHAIN_MODEL_ENTRY_URL=
TOOLCHAIN_TOOL_ENTRY_URL=
TOOLCHAIN_TOOLS_CATEGORY=my
TOOLCHAIN_TOOLS_TYPES=["api","MY_MCP","knowledge"]
TOOLCHAIN_POP_URL=
TOOLCHAIN_ACCESS_KEY_ID=
TOOLCHAIN_ACCESS_KEY_SECRET=
TOOLCHAIN_WORKSPACE=
TOOLCHAIN_REGION=
TOOLCHAIN_TIMEOUT=30
# live 必须显式授权平台身份访问配置的工作空间；不默认共享服务账号全部权限。
TOOLCHAIN_ALLOWED_SUBJECTS=[]
TOOLCHAIN_DATASET_ENTRY_URL=
TOOLCHAIN_APPLICATION_ENTRY_URL=
# 仅填写供应方确认后的索引/检索参数映射，格式见 config/toolchain-knowledge.example.json。
TOOLCHAIN_KNOWLEDGE_CONFIGURATION=
# 管理端「工具链接入配置」保存到此文件，后端重启后覆盖上面的工具链参数。
# 不存在时沿用环境配置；此文件含凭据，保存在已忽略的本地运行目录。
TOOLCHAIN_CONFIGURATION_FILE=.runtime/toolchain-configuration.json
# 公共身份模块/运维维护的可信目录，成员 ID 必须等于认证会话 subject。
# 配置后缺失或停用的成员会被拒绝，不再自动赋予发布者/管理员角色。
APPLICATIONS_IDENTITY_DIRECTORY=
# 知识库资料和文档审核存新表，原件存 MinIO，开发索引运行态存 Redis。
# 模型端点使用完整 URL（如 /v1/embeddings、/v1/rerank），不配置时可使用经济模式全文检索。
KNOWLEDGE_EMBEDDING_URL=
KNOWLEDGE_RERANK_URL=
KNOWLEDGE_RERANK_MODEL=bge-reranker-v2-m3
KNOWLEDGE_MODEL_KEY=
